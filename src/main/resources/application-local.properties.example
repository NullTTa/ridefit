spring.application.name=ridefit

# createDatabaseIfNotExist=true 덕분에 ridefit 스키마를 미리 만들어두지 않아도
# 첫 실행 시 앱이 알아서 생성한다.
spring.datasource.url=jdbc:mysql://localhost:3306/ridefit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&createDatabaseIfNotExist=true
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# 32바이트(256비트) 이상의 임의 문자열로 바꿔서 사용하세요.
jwt.secret=change-this-to-a-long-random-secret-string
jwt.expiration-ms=86400000

# 환경변수(AI_SYNTH_MODE, POLLINATIONS_API_KEY, GEMINI_API_KEY) 대신
# 이 파일에 직접 값을 채워도 된다. 절대 실제 키 값을 커밋하지 말 것.
# ai.synth.mode=mock
# pollinations.api-key=
# gemini.api-key=

# AI 장착(OpenAI Image API). 가능하면 환경변수 OPENAI_API_KEY로 넣고, 이 파일에 넣더라도 절대 커밋하지 말 것.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium

# AI 장착을 Gemini로 쓰려면 아래 한 줄에 키를 넣는다(OpenAI 키가 없으면 자동으로 Gemini를 쓴다). 절대 커밋하지 말 것.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# AI_FIT_PROVIDER=auto

# AI 장착을 Magic Hour로 쓰려면 아래 두 줄을 넣는다(키는 = 뒤에 직접 입력). 절대 커밋하지 말 것.
# MAGICHOUR_API_KEY=
# AI_FIT_PROVIDER=magichour
# MAGICHOUR_IMAGE_MODEL=flux-2-klein
# MAGICHOUR_IMAGE_RESOLUTION=640px

# Toss Payments 테스트 시크릿 키(test_sk_... 또는 test_gsk_...). 라이브 키 금지.
