# Kakao Developers > 내 애플리케이션 > 앱 키 > "JavaScript 키" (REST API 키 아님)
# Kakao Developers > 플랫폼 > Web 플랫폼 등록에 http://localhost:5173 을 등록해야 로컬에서 지도가 뜬다.
# 이 값이 비어 있으면 /services 화면은 지도 대신 "지도를 불러올 수 없습니다" 안내로 자연스럽게 대체된다.
VITE_KAKAO_MAP_KEY=

# 백엔드 API 주소. 비우면 http://localhost:8080 을 쓴다.
VITE_API_BASE_URL=

# Toss Payments 테스트 클라이언트 키(test_ck_... 또는 test_gck_...). 라이브 키 금지. 비우면 결제 화면에 설정 안내가 나온다.
VITE_TOSS_CLIENT_KEY=
